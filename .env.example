# ==============================================================================
# NutriForge Environment Variables
# ==============================================================================

# Frontend API Base URL (leave empty for local dev proxy, or set to https://your-backend.onrender.com/api for production)
VITE_API_URL=

# Government of India Data.gov.in API Key (Optional for live mandi prices)
# Get a free personal API key from https://data.gov.in
DATA_GOV_IN_KEY=

# State for AGMARKNET Mandi Price Resolution (Default: Uttar Pradesh)
PRICE_STATE=Uttar Pradesh

# Wholesale to Retail Markup factor (Default: 1.30 = 30% retail margin)
RETAIL_MARKUP=1.30

# Optional secret key to protect the POST /api/prices/sync endpoint via X-Sync-Secret header
SYNC_SECRET=
